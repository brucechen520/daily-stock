# 複製成 .env 後填值（.env 已在 .gitignore）
DATABASE_URL=postgres://stock:devpass_change_me@localhost:5432/stock?sslmode=disable

# Redis（rediskit：排程 lock + 出站 rate limit）。留空 = 停用（lock/limit 變 no-op）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=devpass_change_me

# LLM provider: anthropic | ollama
LLM_PROVIDER=anthropic     # anthropic | gemini | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 新聞 RSS 來源（逗號分隔）。cnyes RSS 已失效，預設用自由時報財經
NEWS_FEEDS=https://news.ltn.com.tw/rss/business.xml

# Discord 推播（Phase 1.5）。伺服器設定 → 整合 → Webhook → 複製 Webhook 網址。
# 留空 = 不推播，push 指令會明確報錯（靜默不送會讓人以為推播正常）。
DISCORD_WEBHOOK_URL=

# Kafka（可選，需 --profile pipeline）
ENABLE_KAFKA=false
KAFKA_BROKERS=localhost:9092
